+/* ---- PicoCar (IS11) application hooks ------------------------------
+ * Telemetry: every APP_MQTT_TELEMETRY_MS the service task asks the
+ * application for packed telemetry and publishes it with QoS 0.
+ * Commands: payloads received on the command topic (QoS 1) are passed
+ * raw to the application.  Both hooks run in this service task: the
+ * application side must never block.  The weak defaults below keep the
+ * template behaviour when no application provides them. */
+#ifndef APP_MQTT_TELEMETRY_TOPIC
+#define APP_MQTT_TELEMETRY_TOPIC	"is11/telemetry"
+#endif
+#ifndef APP_MQTT_COMMAND_TOPIC
+#define APP_MQTT_COMMAND_TOPIC		"is11/cmd"
+#endif
+#define APP_MQTT_TELEMETRY_MS		200
+#define APP_MQTT_MAX_PER_TICK		2
+#define APP_MQTT_PAYLOAD_MAX		64
+
+int __attribute__((weak)) app_mqtt_take_telemetry(unsigned char *buf, int max_len)
+{
+	(void)buf; (void)max_len;
+	return 0;
+}
+void __attribute__((weak)) app_mqtt_on_command(const unsigned char *data, int len)
+{
+	(void)data; (void)len;
+}
+
+static unsigned char	rx_raw[MQTT_UTK_RX_DATA_MAX];
+static u16_t		rx_raw_len;
+static void telemetry_timeout(void *arg);

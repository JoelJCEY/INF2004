+static void telemetry_timeout(void *arg)
+{
+	unsigned char	buf[APP_MQTT_PAYLOAD_MAX];
+	int		n;
+	int		k;
+
+	(void)arg;
+	if(mqtt_client_is_connected(client)) {
+		for(k = 0; k < APP_MQTT_MAX_PER_TICK; k++) {
+			n = app_mqtt_take_telemetry(buf, (int)sizeof(buf));
+			if(n <= 0) {
+				break;
+			}
+			(void)mqtt_publish(client, APP_MQTT_TELEMETRY_TOPIC, buf, (u16_t)n,
+					   0 /* qos */, 0 /* retain */, publish_done_cb, NULL);
+		}
+	}
+	sys_timeout(APP_MQTT_TELEMETRY_MS, telemetry_timeout, NULL);
+}
